# Plantilla de variables de entorno — copia a .env y rellena con tus credenciales.
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup and configuration

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBilZAqSE2CGeAEMuabVtvK6YYRrsLD0n4
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=quickbite-6dee7.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=quickbite-6dee7
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=373417616626
EXPO_PUBLIC_FIREBASE_APP_ID=1:373417616626:web:92364e6b15af6133aa9c6b

# Google Maps (Android/iOS) — usado en build por app.config.js
GOOGLE_MAPS_API_KEY=AIzaSy...

# Google Geocoding API (resolución de direcciones desde el cliente JS). Puede
# ser la MISMA key que arriba, pero necesita "Geocoding API" habilitada en Google
# Cloud + billing. Si se deja vacía, la app cae a Nominatim (gratis) y al
# geocoder nativo. Al cambiar .env reinicia el bundler con caché limpia:
#   npx expo start -c
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# Google Sign-In — OAuth client ID de tipo "Web"
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com

# Openpay — solo merchant id + PUBLIC key (seguros en el cliente, se usan para
# tokenizar la tarjeta). La PRIVATE key NUNCA va aquí: va en Cloud Functions con
# `firebase functions:secrets:set OPENPAY_PRIVATE_KEY`.
# Dashboard Openpay → sandbox → ID de comercio y Llave pública.
EXPO_PUBLIC_OPENPAY_MERCHANT_ID=mzdtln0bmtms6o3kck8f
EXPO_PUBLIC_OPENPAY_PUBLIC_KEY=pk_e568c42a6c384b7ab02cd47d2e407cab
EXPO_PUBLIC_OPENPAY_SANDBOX=true
