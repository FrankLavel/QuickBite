rules_version = '2';

// Reglas de seguridad de QuickBite (App Móvil + Dashboard Web del Restaurante).
// Dos roles, ambos autenticados con Firebase Auth + Firestore (sin Admin SDK):
//   - 'customer' (app móvil): se autoregistra, gestiona su propio perfil/pedidos/
//     notificaciones, y solo lee catálogo/ofertas/cupones.
//   - 'restaurant' (dashboard web): NO se autoregistra desde el cliente — su
//     documento /users/{uid} (con role='restaurant' y restaurantId) lo provisiona
//     el equipo del dashboard por fuera de estas reglas (Admin SDK/Cloud Function),
//     para evitar que cualquiera se autoasigne un restaurantId. Una vez provisionado,
//     administra su propio restaurante/menú/ofertas/cupones y el status de sus pedidos.
//   - 'driver' (app QuickBite Driver): NO se autoregistra (lo provisiona el admin,
//     igual que 'restaurant'). En modelo auto-servicio reclama pedidos 'ready' sin
//     repartidor y avanza su status: 'ready' -> 'on_the_way' -> 'delivered'.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // El restaurante autenticado solo administra el restaurantId que le fue asignado.
    function isRestaurantOwner(restId) {
      return isSignedIn()
             && currentUserData().role == 'restaurant'
             && currentUserData().restaurantId == restId;
    }

    // El repartidor autenticado (rol 'driver', provisionado por el admin).
    function isDriver() {
      return isSignedIn() && currentUserData().role == 'driver';
    }

    // Compra verificada para reseñas: el pedido existe, es del usuario actual y
    // está 'delivered'. (No se valida que el producto esté en items[] porque las
    // reglas no pueden recorrer arrays de maps; eso lo garantiza el cliente.)
    function orderIsDeliveredForUser(orderId) {
      return exists(/databases/$(database)/documents/orders/$(orderId))
             && get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid
             && get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'delivered';
    }

    // Solo estos campos del perfil puede editar el cliente (nunca role/restaurantId/email/createdAt).
    function onlyEditableUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'phone', 'photoURL', 'addresses', 'favoriteIds', 'favoriteProductIds', 'darkMode', 'pushToken', 'webPushSubscription']);
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isUser(uid);

      // Autoregistro: solo permite crear el propio perfil como 'customer'.
      // Las cuentas 'restaurant' se provisionan fuera del cliente (ver nota arriba).
      allow create: if isUser(uid)
                    && request.resource.data.role == 'customer';

      allow update: if isUser(uid) && onlyEditableUserFields();
      // El usuario puede eliminar su propio perfil (opción "Eliminar cuenta").
      allow delete: if isUser(uid);

      // ---------- users/{uid}/notifications ----------
      // Las crea Cloud Functions (Admin SDK). El cliente solo lee y marca isRead.
      match /notifications/{notifId} {
        allow read: if isUser(uid);
        allow update: if isUser(uid)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow create: if false;
        // El cliente puede borrar sus propias notificaciones (limpiar historial).
        allow delete: if isUser(uid);
      }

      // ---------- users/{uid}/cards (tarjetas guardadas) ----------
      // Solo referencias (marca, últimos 4, card_id de Openpay), NUNCA el PAN.
      // Las crea/borra Cloud Functions (Admin SDK) al hablar con Openpay; el
      // cliente solo lee las suyas.
      match /cards/{cardId} {
        allow read: if isUser(uid);
        allow write: if false;
      }
    }

    // ---------- restaurants ----------
    match /restaurants/{restId} {
      allow read: if isSignedIn();
      allow write: if isRestaurantOwner(restId);

      match /categories/{catId} {
        allow read: if isSignedIn();
        allow write: if isRestaurantOwner(restId);
      }

      match /products/{prodId} {
        allow read: if isSignedIn();
        allow write: if isRestaurantOwner(restId);

        // Reseñas de producto: doc id = uid del autor (una por usuario/producto).
        // Solo quien tiene un pedido 'delivered' propio puede crear/editar la suya.
        match /reviews/{userId} {
          allow read: if isSignedIn();
          allow create, update: if isUser(userId)
                        && request.resource.data.userId == userId
                        && request.resource.data.rating is int
                        && request.resource.data.rating >= 1
                        && request.resource.data.rating <= 5
                        && request.resource.data.comment is string
                        && orderIsDeliveredForUser(request.resource.data.orderId);
          allow delete: if isUser(userId);
        }
      }
    }

    // ---------- offers (banners promocionales) ----------
    match /offers/{offerId} {
      allow read: if isSignedIn();
      allow create: if isRestaurantOwner(request.resource.data.restaurantId);
      allow update, delete: if isRestaurantOwner(resource.data.restaurantId);
    }

    // ---------- coupons (uno por restaurante) ----------
    match /coupons/{code} {
      allow read: if isSignedIn();

      allow create: if isRestaurantOwner(request.resource.data.restaurantId);

      // El restaurante dueño edita el cupón; el cliente solo puede incrementar
      // usedCount en exactamente 1 (al aplicarlo en su pedido).
      allow update: if isRestaurantOwner(resource.data.restaurantId)
                    || (isSignedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
                        && request.resource.data.usedCount == resource.data.usedCount + 1);

      allow delete: if isRestaurantOwner(resource.data.restaurantId);
    }

    // ---------- orders ----------
    match /orders/{orderId} {
      // El cliente dueño del pedido, o el restaurante que lo recibió, pueden leerlo.
      // El repartidor ve los pedidos disponibles ('ready') y los que le pertenecen.
      allow read: if isSignedIn()
                  && (resource.data.customerId == request.auth.uid
                      || isRestaurantOwner(resource.data.restaurantId)
                      || (isDriver()
                          && (resource.data.status == 'ready'
                              || resource.data.get('driverId', '') == request.auth.uid)));

      // Crear: el customerId debe ser el usuario actual y el estado inicial
      // 'pending'. Además el cliente NO puede marcar el pedido como pagado: los
      // pedidos con tarjeta los crea Cloud Functions (Admin SDK) tras cobrar en
      // Openpay; los que crea el cliente (efectivo/PayPal) van con 'pending'.
      allow create: if isSignedIn()
                    && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.paymentStatus == 'pending';

      // Cliente: agrega/edita su calificación, o cancela el pedido mientras
      // sigue en 'pending' (status -> 'cancelled', + cancelledAt).
      // Restaurante: solo avanza status/estimatedTime/acceptedAt/deliveredAt
      // (nunca items, montos, dirección o customerId).
      allow update: if isSignedIn()
                    && (
                      (resource.data.customerId == request.auth.uid
                       && (
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating'])
                         ||
                         (resource.data.status == 'pending'
                          && request.resource.data.status == 'cancelled'
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']))
                       ))
                      ||
                      (isRestaurantOwner(resource.data.restaurantId)
                       && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status', 'estimatedTime', 'acceptedAt', 'deliveredAt', 'settledAt', 'rejectionReason']))
                      ||
                      // Repartidor reclama un pedido disponible ('ready' y sin driver).
                      (isDriver()
                       && resource.data.status == 'ready'
                       && resource.data.get('driverId', '') == ''
                       && request.resource.data.driverId == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['driverId', 'driverName', 'driverPhone', 'assignedAt']))
                      ||
                      // Repartidor asignado marca recogido: 'ready' -> 'on_the_way'.
                      (isDriver()
                       && resource.data.get('driverId', '') == request.auth.uid
                       && resource.data.status == 'ready'
                       && request.resource.data.status == 'on_the_way'
                       && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status', 'pickedUpAt']))
                      ||
                      // Repartidor asignado marca entregado: 'on_the_way' -> 'delivered'.
                      (isDriver()
                       && resource.data.get('driverId', '') == request.auth.uid
                       && resource.data.status == 'on_the_way'
                       && request.resource.data.status == 'delivered'
                       && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status', 'deliveredAt']))
                    );

      allow delete: if false;
    }

    // ---------- deliveryTracking (ubicación en vivo del repartidor) ----------
    // Un doc por pedido (id = orderId) con lat/lng/updatedAt. Solo existe mientras
    // hay una entrega en curso; el repartidor lo borra al entregar (privacidad).
    match /deliveryTracking/{orderId} {
      function orderData() {
        return get(/databases/$(database)/documents/orders/$(orderId)).data;
      }

      // Escribe el repartidor asignado a ese pedido (verificado contra el pedido).
      allow create, update: if isDriver()
                    && request.resource.data.driverId == request.auth.uid
                    && orderData().driverId == request.auth.uid;

      // Leen: el repartidor, el cliente dueño del pedido y el restaurante receptor.
      allow read: if isSignedIn()
                  && (resource.data.driverId == request.auth.uid
                      || orderData().customerId == request.auth.uid
                      || isRestaurantOwner(orderData().restaurantId));

      // El repartidor asignado borra el rastro al completar la entrega.
      allow delete: if isDriver() && orderData().driverId == request.auth.uid;
    }
  }
}
